{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookTTS",
  "version": "0.3.1",
  "identifier": "app.booktts.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BookTTS",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Artyom Illiy",
    "shortDescription": "Многоголосые аудиокниги из текста",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2NjkyRkE4Mjc0MTk3MwpSV1J6R1hTQytwSm1DWlZJU2VHMmdscVk5MTA2WDgwdlJxUDEySTBYNWNxZzR1T3kzNFJZQXQzMwo=",
      "endpoints": [
        "https://github.com/Mauzek/BooksTTS/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
