{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Окно приложения: заставка и интерфейс, который отдаёт локальный бэкенд.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-backend-status",
    "allow-restart-backend",
    "allow-notify",
    "allow-app-version",
    "allow-check-update",
    "allow-install-update"
  ]
}
